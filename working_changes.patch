+static uint32_t
+median3 (uint32_t a_val, uint32_t b_val, uint32_t c_val)
+{
+    uint32_t const hi_ab = (a_val > b_val) ? a_val : b_val;
+    uint32_t const lo_ab = (a_val > b_val) ? b_val : a_val;
+    uint32_t const mid   = (c_val > hi_ab) ? hi_ab :
+                           ((c_val < lo_ab) ? lo_ab : c_val);
